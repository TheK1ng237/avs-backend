# ─────────────────────────────────────────────────────────────────────────────
# AVS BACKEND — Variables d'Environnement
# ─────────────────────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_NAME="AVS Backend API"

# Base de données
DATABASE_URL=""

# JWT — générer avec : openssl rand -base64 64
JWT_SECRET=example_jwt_secret_base64_which_is_not_real
JWT_REFRESH_SECRET=example_jwt_refresh_secret_base64_not_real
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — URL du frontend
FRONTEND_URL=http://localhost:3000

ALLOWED_ORIGINS=http://localhost:3000,https://avs-standard.com

# Redis (rate limiting / cache)
REDIS_URL=redis://localhost:6379

# Email
# Resend API key (SMTP_PASS is also accepted as a compatibility fallback)
RESEND_API_KEY=re_votre_cle_resend
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_VOTRE_CLE
EMAIL_FROM=noreply@avs-standard.com

# Stockage
STORAGE_PROVIDER=local  # local | s3 | gcs
STORAGE_BUCKET=avs-assets

# Monitoring
SENTRY_DSN=https://VOTRE_DSN@sentry.io/0
LOG_LEVEL=debug

# AWS S3 (si vous utilisez S3)
AWS_REGION=us-east-1
AWS_BUCKET=example-bucket
AWS_ACCESS_KEY_ID=example_aws_key_id
AWS_SECRET_ACCESS_KEY=example_aws_secret

# Cloudinary (si vous utilisez Cloudinary)
CLOUDINARY_CLOUD_NAME=example_cloud
CLOUDINARY_API_KEY=example_cloudinary_key
CLOUDINARY_API_SECRET=example_cloudinary_secret

# Supabase (si vous utilisez Supabase Storage)
SUPABASE_URL=https://example.supabase.co
SUPABASE_SERVICE_ROLE_KEY=example_supabase_service_role_key
